# --- Security (IMPORTANT!) ---
# These files contain secrets and must NEVER end up on GitHub
.env
.env.local
.env.*.local

# --- Frontend (Node/Next.js) ---
# Dependencies (can be restored anytime with npm install)
node_modules/
# Build folder from Next.js
.next/
build/
dist/
out/
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Backend (Go) ---
# Compiled binaries/exe files (we don't want these in the code)
*.exe
*.test
*.out

# --- System & Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
# The panel's static export, copied in before `go build` (see core/Dockerfile).
# Only the placeholder is committed: the real bundle is ~10 MB of build output
# that would land in every diff, and a stale committed copy is worse than none -
# it compiles, boots, and serves a panel from whenever it was last checked in.
# The `dist/` rule above excludes this directory outright, and git does not look
# inside an excluded directory - so the negation has to re-include the directory
# before it can re-include a file in it.
!panelfs/dist/
panelfs/dist/*
!panelfs/dist/index.html
