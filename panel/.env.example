# ===========================================
# Dylaris Panel - Environment Configuration
# ===========================================
#
# These are BUILD-TIME variables (NEXT_PUBLIC_* are inlined when the image is
# built and cannot be changed afterwards). For self-hosting a prebuilt image,
# prefer the RUNTIME shim at public/config.js (window.__DYLARIS_CONFIG__.apiUrl)
# which you can edit or bind-mount without rebuilding.

# Backend API base URL (must include the /api suffix).
# Used by local dev and by anyone who builds the panel themselves.
# If unset at runtime, the panel talks to the same origin it is served from
# (e.g. https://your-panel-host/api) - the typical reverse-proxy layout.
# Local dev (panel and Core on different ports) falls back to localhost:25500.
NEXT_PUBLIC_API_URL=http://localhost:25500/api

# Next.js server port
# PORT=3000
